From f2f5f0456df38f451f5a0a2868e42cace2761d34 Mon Sep 17 00:00:00 2001
From: Daytona <daytona@localhost>
Date: Thu, 26 Nov 2026 16:56:29 +0000
Subject: [PATCH] ssd: show a pressed image while a titlebar button is held

Themes can add BUTTON[_toggled]_pressed images (for example
close_pressed-active.svg), shown while the left mouse button is held
down on a titlebar button with the cursor over it. Moving the cursor
off the button shows the normal image again, and back on shows the
pressed one, as in Windows. Themes without pressed images look the
same as before.
---
 docs/labwc-theme.5.scd |  9 ++++++
 include/ssd-internal.h |  7 +++++
 include/ssd.h          |  3 ++
 include/theme.h        |  4 ++-
 src/input/cursor.c     |  8 ++++++
 src/ssd/ssd-titlebar.c | 65 ++++++++++++++++++++++++++++++++++++++++++
 src/ssd/ssd.c          |  3 ++
 src/theme.c            | 36 ++++++++++++++++++++++-
 8 files changed, 133 insertions(+), 2 deletions(-)

diff --git a/docs/labwc-theme.5.scd b/docs/labwc-theme.5.scd
index 11d0f055..7e794bbd 100644
--- a/docs/labwc-theme.5.scd
+++ b/docs/labwc-theme.5.scd
@@ -390,6 +390,15 @@ over the button in question:
 - shade_hover.xbm
 - shade_toggle_hover.xbm
 
+Icons can also be defined to be shown while the left mouse button is held down
+on the button in question, with the mouse pointer over it, by adding
+"_pressed" to the name (after "_toggled" where there is one), for example:
+
+- close_pressed.xbm
+- max_toggled_pressed.xbm
+
+Where there is no pressed icon, the button looks the same when pressed.
+
 One advantage of xbm buttons over other formats is that they change color based
 on the theme. Other formats use the suffices "-active" and "-inactive" to align
 with the respective titlebar colors. For example: "close-active.png"
diff --git a/include/ssd-internal.h b/include/ssd-internal.h
index d46e7280..c25322db 100644
--- a/include/ssd-internal.h
+++ b/include/ssd-internal.h
@@ -134,6 +134,13 @@ struct ssd_part {
 struct ssd_hover_state {
 	struct view *view;
 	struct ssd_button *button;
+	/*
+	 * The button the left mouse button was pressed on, while it is held.
+	 * Kept as view and button type, as the active and inactive titlebars
+	 * each have their own copy of the button.
+	 */
+	struct view *pressed_view;
+	enum ssd_part_type pressed_type;
 };
 
 struct wlr_buffer;
diff --git a/include/ssd.h b/include/ssd.h
index 5cbac60a..576099de 100644
--- a/include/ssd.h
+++ b/include/ssd.h
@@ -102,6 +102,9 @@ void ssd_enable_shade(struct ssd *ssd, bool enable);
 struct ssd_hover_state *ssd_hover_state_new(void);
 void ssd_update_button_hover(struct wlr_scene_node *node,
 	struct ssd_hover_state *hover_state);
+void ssd_button_press(struct wlr_scene_node *node,
+	struct ssd_hover_state *hover_state);
+void ssd_button_release(struct ssd_hover_state *hover_state);
 
 enum ssd_part_type ssd_button_get_type(const struct ssd_button *button);
 struct view *ssd_button_get_view(const struct ssd_button *button);
diff --git a/include/theme.h b/include/theme.h
index a5f071ff..b86026a9 100644
--- a/include/theme.h
+++ b/include/theme.h
@@ -34,8 +34,10 @@ enum lab_button_state {
 	LAB_BS_HOVERD = 1 << 0,
 	LAB_BS_TOGGLED = 1 << 1,
 	LAB_BS_ROUNDED = 1 << 2,
+	LAB_BS_PRESSED = 1 << 3,
 
-	LAB_BS_ALL = LAB_BS_HOVERD | LAB_BS_TOGGLED | LAB_BS_ROUNDED,
+	LAB_BS_ALL = LAB_BS_HOVERD | LAB_BS_TOGGLED | LAB_BS_ROUNDED
+		| LAB_BS_PRESSED,
 };
 
 struct theme {
diff --git a/src/input/cursor.c b/src/input/cursor.c
index e9ae9ad0..91f2314c 100644
--- a/src/input/cursor.c
+++ b/src/input/cursor.c
@@ -1075,6 +1075,11 @@ cursor_process_button_press(struct seat *seat, uint32_t button, uint32_t time_ms
 		return false;
 	}
 
+	if (button == BTN_LEFT
+			&& server->input_mode == LAB_INPUT_STATE_PASSTHROUGH) {
+		ssd_button_press(ctx.node, server->ssd_hover_state);
+	}
+
 	/* Bindings to the Frame context swallow mouse events if activated */
 	bool consumed_by_frame_context =
 		handle_press_mousebinding(server, &ctx, button);
@@ -1100,6 +1105,9 @@ cursor_process_button_release(struct seat *seat, uint32_t button,
 	const bool notify = !lab_set_contains(&seat->bound_buttons, button);
 
 	seat_reset_pressed(seat);
+	if (button == BTN_LEFT) {
+		ssd_button_release(server->ssd_hover_state);
+	}
 
 	if (server->input_mode == LAB_INPUT_STATE_MENU) {
 		/* TODO: take into account overflow of time_msec */
diff --git a/src/ssd/ssd-titlebar.c b/src/ssd/ssd-titlebar.c
index 2879b203..fdeb12d4 100644
--- a/src/ssd/ssd-titlebar.c
+++ b/src/ssd/ssd-titlebar.c
@@ -525,6 +525,70 @@ ssd_update_title(struct ssd *ssd)
 	ssd_update_title_positions(ssd, offset_left, offset_right);
 }
 
+/* Shows or hides the pressed image of a button in both titlebars */
+static void
+set_button_pressed(struct view *view, enum ssd_part_type type, bool enable)
+{
+	struct ssd *ssd = view->ssd;
+	if (!ssd || !ssd->titlebar.tree) {
+		return;
+	}
+
+	struct ssd_sub_tree *subtree;
+	FOR_EACH_STATE(ssd, subtree) {
+		struct ssd_part *part = ssd_get_part(&subtree->parts, type);
+		if (part) {
+			update_button_state(node_ssd_button_from_node(part->node),
+				LAB_BS_PRESSED, enable);
+		}
+	} FOR_EACH_END
+}
+
+/*
+ * As in Windows, a button looks pressed while the mouse button is held
+ * and the cursor is over it.
+ */
+static void
+update_button_pressed(struct ssd_hover_state *hover_state)
+{
+	if (!hover_state->pressed_view) {
+		return;
+	}
+	struct ssd_button *button = hover_state->button;
+	set_button_pressed(hover_state->pressed_view,
+		hover_state->pressed_type,
+		button && button->view == hover_state->pressed_view
+			&& button->type == hover_state->pressed_type);
+}
+
+void
+ssd_button_press(struct wlr_scene_node *node,
+		struct ssd_hover_state *hover_state)
+{
+	ssd_button_release(hover_state);
+	if (!node || !node->data) {
+		return;
+	}
+	struct node_descriptor *desc = node->data;
+	if (desc->type != LAB_NODE_DESC_SSD_BUTTON) {
+		return;
+	}
+	struct ssd_button *button = node_ssd_button_from_node(node);
+	hover_state->pressed_view = button->view;
+	hover_state->pressed_type = button->type;
+	set_button_pressed(button->view, button->type, true);
+}
+
+void
+ssd_button_release(struct ssd_hover_state *hover_state)
+{
+	if (hover_state->pressed_view) {
+		set_button_pressed(hover_state->pressed_view,
+			hover_state->pressed_type, false);
+		hover_state->pressed_view = NULL;
+	}
+}
+
 void
 ssd_update_button_hover(struct wlr_scene_node *node,
 		struct ssd_hover_state *hover_state)
@@ -554,6 +618,7 @@ disable_old_hover:
 		hover_state->view = button->view;
 		hover_state->button = button;
 	}
+	update_button_pressed(hover_state);
 }
 
 bool
diff --git a/src/ssd/ssd.c b/src/ssd/ssd.c
index 65416ca3..00a87bca 100644
--- a/src/ssd/ssd.c
+++ b/src/ssd/ssd.c
@@ -354,6 +354,9 @@ ssd_destroy(struct ssd *ssd)
 		hover_state->view = NULL;
 		hover_state->button = NULL;
 	}
+	if (hover_state->pressed_view == view) {
+		hover_state->pressed_view = NULL;
+	}
 
 	/* Destroy subcomponents */
 	ssd_titlebar_destroy(ssd);
diff --git a/src/theme.c b/src/theme.c
index 826b0953..7389ae5b 100644
--- a/src/theme.c
+++ b/src/theme.c
@@ -214,6 +214,15 @@ load_button(struct theme *theme, struct button *b, int active)
 		*img = lab_img_load_from_bitmap(b->fallback_button, rgba);
 	}
 
+	/*
+	 * If pressed-icons do not exist, the button looks the same pressed as
+	 * it does when not pressed.
+	 */
+	if (!*img && (b->state_set & LAB_BS_PRESSED)) {
+		*img = lab_img_copy(
+			button_imgs[b->type][b->state_set & ~LAB_BS_PRESSED]);
+	}
+
 	/*
 	 * If hover-icons do not exist, add fallbacks by copying the non-hover
 	 * variant and then adding an overlay.
@@ -260,7 +269,9 @@ load_button(struct theme *theme, struct button *b, int active)
  * with the words separated by underscore, and the following meaning:
  *   - BUTTON can be one of 'max', 'iconify', 'close', 'menu'
  *   - TOGGLED is either 'toggled' or nothing
- *   - STATE is 'hover' or nothing. In future, 'pressed' may be supported too.
+ *   - STATE is 'hover', 'pressed' or nothing. A pressed image is shown
+ *     while the button is held down with the cursor over it, whether or not
+ *     the cursor counts as hovering.
  *
  * We believe that this is how the vast majority of extant openbox themes out
  * there are constructed and it is consistent with the openbox.org wiki. But
@@ -388,6 +399,29 @@ load_buttons(struct theme *theme)
 		load_button(theme, b, THEME_INACTIVE);
 		load_button(theme, b, THEME_ACTIVE);
 	}
+
+	/*
+	 * Pressed variants, for example "max_toggled_pressed". They are
+	 * loaded after the others because they fall back to them. The same
+	 * image is used whether or not the button is also hovered.
+	 */
+	for (size_t i = 0; i < ARRAY_SIZE(buttons); ++i) {
+		if (buttons[i].state_set & LAB_BS_HOVERD) {
+			continue;
+		}
+		char name[64];
+		snprintf(name, sizeof(name), "%s_pressed", buttons[i].name);
+		uint8_t states[] = { LAB_BS_PRESSED, LAB_BS_PRESSED | LAB_BS_HOVERD };
+		for (size_t j = 0; j < ARRAY_SIZE(states); ++j) {
+			struct button b = {
+				.name = name,
+				.type = buttons[i].type,
+				.state_set = buttons[i].state_set | states[j],
+			};
+			load_button(theme, &b, THEME_INACTIVE);
+			load_button(theme, &b, THEME_ACTIVE);
+		}
+	}
 }
 
 static int
-- 
