<?xml version="1.0" encoding="UTF-8"?>
<!--
  SPDX-License-Identifier: GPL-3.0-or-later

  The NT window (system) menu, shown by Alt+Space, the window icon and a
  right-click on the titlebar. labwc 0.8.3 cannot disable items that do not
  apply to the window's state, show the Alt+F4 shortcut text or underline
  mnemonics, so those NT details are missing here.
-->
<openbox_menu>
  <menu id="client-menu" label="Window">
    <item label="Restore">
      <action name="UnMaximize" />
    </item>
    <item label="Move">
      <action name="Move" />
    </item>
    <item label="Size">
      <action name="Resize" />
    </item>
    <item label="Minimize">
      <action name="Iconify" />
    </item>
    <item label="Maximize">
      <action name="Maximize" />
    </item>
    <separator />
    <item label="Close">
      <action name="Close" />
    </item>
  </menu>
</openbox_menu>
