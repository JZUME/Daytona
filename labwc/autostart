# Run by labwc at startup.

# Programs that D-Bus or systemd start (portal dialogs such as the file
# chooser, D-Bus-activated applications, systemd user services) get the
# Daytona theme and desktop name too: add them to the activation
# environment, beside the variables labwc adds itself, when labwc does (see
# daytona-session). The labwc shutdown file takes them out again.
case "$(echo "${LABWC_UPDATE_ACTIVATION_ENV:-}" | tr '[:upper:]' '[:lower:]')" in
1 | true | yes | on)
    if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
        dbus-update-activation-environment \
            GTK_THEME QT_STYLE_OVERRIDE XDG_SESSION_DESKTOP >/dev/null 2>&1
        systemctl --user import-environment \
            GTK_THEME QT_STYLE_OVERRIDE XDG_SESSION_DESKTOP >/dev/null 2>&1
        # When Daytona looks after IBus (see daytona-session), the X session
        # scripts may already have put im-config's variables in the
        # activation environment; take out the ones the session took out.
        # D-Bus can only set variables, so they are set empty, which GTK and
        # Qt take as unset.
        if [ -n "${DAYTONA_IBUS:-}" ]; then
            for var in GTK_IM_MODULE QT_IM_MODULE CLUTTER_IM_MODULE XMODIFIERS; do
                if [ -z "$(eval echo "\"\${$var:-}\"")" ]; then
                    dbus-update-activation-environment "$var=" >/dev/null 2>&1
                    systemctl --user unset-environment "$var" >/dev/null 2>&1
                fi
            done
            if [ -n "${XMODIFIERS:-}" ]; then
                dbus-update-activation-environment XMODIFIERS >/dev/null 2>&1
                systemctl --user import-environment XMODIFIERS >/dev/null 2>&1
            fi
        fi
    fi
    ;;
esac

daytona-shell >/dev/null 2>&1 &

# The polkit authentication agent, which asks for an administrator password
# (pkexec, mounting drives, Shut Down when logind asks). LXQt's agent is Qt,
# so it takes the daytona style; its own autostart entry is OnlyShowIn=LXQt,
# so the session starts it here rather than through dex.
if command -v lxqt-policykit-agent >/dev/null; then
    lxqt-policykit-agent >/dev/null 2>&1 &
fi

# Then the applications in the XDG autostart directories (~/.config/autostart
# and /etc/xdg/autostart), honouring Hidden, OnlyShowIn/NotShowIn and TryExec,
# with dex. They start once the shell's notification area is on the session
# bus (org.kde.StatusNotifierWatcher), so their tray icons register with it,
# or after 30 seconds if it never appears. dex starts each one without
# waiting for it, and all of this runs in the background, so a slow or
# failing entry cannot hold up or break the shell.
#
# When NetworkManager's applet is installed, it is the network icon: dex
# first reads Daytona's own entries (share/daytona/xdg/autostart, beside this
# file's share/daytona/labwc), which win over system entries of the same name.
# They start nm-applet with --indicator, which gives it a tray icon here, and
# keep nm-tray from adding a second network icon. Users' own entries still
# win over both.
xdg_config_dirs="${XDG_CONFIG_DIRS:-/etc/xdg}"
if command -v nm-applet >/dev/null; then
    daytona_xdg="$(dirname "$(readlink -f "$0")")/../xdg"
    xdg_config_dirs="$daytona_xdg:$xdg_config_dirs"
fi
{
    # First, the keyring: gnome-keyring's Secret Service
    # (org.freedesktop.secrets), where browsers, mail programs and other
    # applications keep saved passwords. Its own autostart entry is
    # OnlyShowIn=GNOME;Unity;MATE;, so dex would skip it. When the login
    # manager's PAM stack has pam_gnome_keyring (libpam-gnome-keyring), PAM
    # has already started the daemon and unlocked the login keyring with the
    # log-on password; --start finishes starting that daemon, and starts one
    # only if there is none. It comes before the autostart applications, so
    # they find the keyring ready.
    if command -v gnome-keyring-daemon >/dev/null; then
        gnome-keyring-daemon --start --components=secrets
    fi
    gdbus wait --session --timeout 30 org.kde.StatusNotifierWatcher
    # The X11 system tray, for programs that only know the old XEmbed tray
    # icons (GtkStatusIcon, Wine, older Java): daytona-xembed-proxy shows
    # their icons beside the others. Only with Xwayland (labwc sets DISPLAY
    # for it), and before the autostart applications, so it is there when
    # they look for a tray. It ends with the X display, at log off.
    xembed_proxy="$(dirname "$(readlink -f "$0")")/../../../libexec/daytona/daytona-xembed-proxy"
    if [ -n "${DISPLAY:-}" ] && [ -x "$xembed_proxy" ] && command -v Xwayland >/dev/null; then
        "$xembed_proxy" &
    fi
    # The input method, when daytona-session found one set up in IBus: IBus
    # started the Wayland way, as its "IBus Wayland" entry does, so it uses
    # labwc's input method protocol (and XIM for X11 programs), with its own
    # icon in the notification area. Before the autostart applications, so
    # they find it.
    if [ "${DAYTONA_IBUS:-}" = start ] && [ -n "${DAYTONA_IBUS_EXEC:-}" ]; then
        sh -c "exec $DAYTONA_IBUS_EXEC" &
    fi
    XDG_CONFIG_DIRS="$xdg_config_dirs" dex --autostart --environment Daytona
} >/dev/null 2>&1 &
