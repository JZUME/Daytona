#
# Daytona: Windows NT 4.0 "Windows Standard" colours for labwc 0.8.3.
# Original artwork. Colours here are plain values so that daytona-themetool
# can generate variants from Windows .theme files.
#
# Window frames are NT's 4 pixel raised frame: the window.border.bevel keys
# come from Daytona's labwc patch (patches/labwc); stock labwc ignores them and
# draws a flat border. Menus are flat, and caption buttons have no pressed
# image (labwc limits).

border.width: 4
window.active.border.color: #c0c0c0
window.inactive.border.color: #c0c0c0
window.border.bevel: yes
window.border.bevel.light.color: #c0c0c0
window.border.bevel.highlight.color: #ffffff
window.border.bevel.shadow.color: #808080
window.border.bevel.darkshadow.color: #000000
window.active.indicator.toggled-keybind.color: #c0c0c0

window.titlebar.padding.width: 2
window.titlebar.padding.height: 2

window.active.title.bg.color: #000080
window.inactive.title.bg.color: #808080
window.active.label.text.color: #ffffff
window.inactive.label.text.color: #c0c0c0
window.label.text.justify: Left

window.button.width: 16
window.button.height: 14
window.button.spacing: 0
window.button.hover.bg.corner-radius: 0

window.active.shadow.size: 0
window.inactive.shadow.size: 0

menu.border.width: 2
menu.border.color: #808080
menu.items.padding.x: 12
menu.items.padding.y: 3
menu.items.bg.color: #c0c0c0
menu.items.text.color: #000000
menu.items.active.bg.color: #000080
menu.items.active.text.color: #ffffff
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 3
menu.separator.color: #808080
menu.title.bg.color: #000080
menu.title.text.color: #ffffff
menu.title.text.justify: Left
menu.overlap.x: 0
menu.overlap.y: 0

osd.bg.color: #c0c0c0
osd.border.color: #808080
osd.border.width: 2
osd.label.text.color: #000000
osd.window-switcher.padding: 4
osd.window-switcher.item.active.border.width: 1
osd.window-switcher.preview.border.color: #000000,#ffffff,#000000
