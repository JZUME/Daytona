#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -e

# The log on screen remembers the last user name and session in
# /var/lib/daytona-greeter, as greetd's greeter user (_greetd on Debian).
if [ "$1" = configure ] && getent passwd _greetd >/dev/null; then
    chown _greetd: /var/lib/daytona-greeter
    chmod 0755 /var/lib/daytona-greeter
fi

#DEBHELPER#

exit 0
