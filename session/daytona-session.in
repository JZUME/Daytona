#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Starts a Daytona session: labwc with Daytona's configuration, which in turn
# starts daytona-shell from its autostart file.

# Desktop name used for OnlyShowIn/NotShowIn and by portals. Display managers
# usually set this from DesktopNames already; set it for direct starts too.
export XDG_CURRENT_DESKTOP=Daytona
export XDG_SESSION_DESKTOP=Daytona
# Start > Programs, and menu editors, use daytona-applications.menu (as
# other desktops use their own prefix). Kept if already set.
export XDG_MENU_PREFIX="${XDG_MENU_PREFIX:-daytona-}"

# GTK 3 applications use the Daytona GTK theme (Chicago95 in the current
# colour scheme), and everything uses the Windows 95 cursors. Set here, for
# this session only, so other desktops' settings are left alone.
export GTK_THEME=Daytona
# Qt 6 applications use the Daytona style (Qt 5 ones cannot load it; see
# docs/third-party-apps.md).
export QT_STYLE_OVERRIDE=daytona
# Daytona's cursors (Chicago95's, at every size) in the pointer scheme chosen
# in Mouse Properties: its size, which labwc and applications multiply by
# the screen scale. Kept in step with PointerScheme in the shell.
export XCURSOR_THEME="Daytona Cursors"
daytona_ini="${XDG_CONFIG_HOME:-$HOME/.config}/daytona/daytona.ini"
pointer_scheme=$(sed -n '/^\[Mouse\]/,/^\[/s/^PointerScheme[[:space:]]*=[[:space:]]*//p' \
    "$daytona_ini" 2>/dev/null | head -n 1 | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
case "$pointer_scheme" in
large) XCURSOR_SIZE=64 ;;
extralarge) XCURSOR_SIZE=96 ;;
*) XCURSOR_SIZE=32 ;;
esac
export XCURSOR_SIZE

# The input method, IBus. Older versions of Debian's im-config start IBus
# for every session in which it is installed, the X11 way: when the login
# manager runs the X session scripts for Wayland sessions too, they set
# GTK_IM_MODULE and QT_IM_MODULE to ibus, and im-config's autostart entry
# (im-launch) starts ibus-daemon, which in a Wayland session only shows a
# balloon at log on asking to be started by the desktop. Newer im-config
# leaves Wayland sessions to the desktop altogether. So Daytona starts IBus
# itself (see the labwc autostart file), unless the session was set up for
# another input method (Fcitx, say): im-launch does nothing (it acts only
# with IM_CONFIG_PHASE), and GTK_IM_MODULE and QT_IM_MODULE are unset, so GTK
# and Qt 6 applications use labwc's text input protocol, as IBus asks. X11
# applications use XIM (XMODIFIERS).
#
# IBus is started only when an input method is set up in it (IBus
# Preferences, Input Method: anything other than a keyboard layout), or, until
# then, for Chinese, Japanese and Korean. Otherwise it would only repeat the
# keyboard layouts, which Daytona switches itself (Keyboard Properties), and
# put a second keyboard icon in the notification area. It is started with the
# Exec line of its "IBus Wayland" entry, from IBus 1.5.32 (older versions
# cannot talk to labwc, and are not started).
#
# DAYTONA_IBUS tells the autostart file what to do: "start", or "off" (IBus
# is installed but not needed).
other_im=""
for value in "${GTK_IM_MODULE:-}" "${QT_IM_MODULE:-}" "${XMODIFIERS#@im=}"; do
    case "$value" in
    "" | ibus) ;;
    *) other_im=yes ;;
    esac
done
if [ -z "$other_im" ] && command -v ibus-daemon >/dev/null; then
    DAYTONA_IBUS=off
    DAYTONA_IBUS_EXEC=""
    for dir in $(echo "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" | tr ':' ' '); do
        entry="$dir/applications/org.freedesktop.IBus.Panel.Wayland.Gtk3.desktop"
        if [ -r "$entry" ]; then
            DAYTONA_IBUS_EXEC="$(sed -n 's/^Exec=//p' "$entry" | head -n 1)"
            break
        fi
    done
    if [ -n "$DAYTONA_IBUS_EXEC" ]; then
        # The input methods (engines) chosen in IBus Preferences, as
        # ['xkb:us::eng', 'mozc-jp']; empty until something is chosen there.
        engines="$(dconf read /desktop/ibus/general/preload-engines 2>/dev/null)"
        if [ -n "$engines" ]; then
            if echo "$engines" | grep -o "'[^']*'" | grep -qv "^'xkb:"; then
                DAYTONA_IBUS=start
            fi
        else
            case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
            zh* | ja* | ko*) DAYTONA_IBUS=start ;;
            esac
        fi
    fi
    unset IM_CONFIG_PHASE GTK_IM_MODULE QT_IM_MODULE CLUTTER_IM_MODULE
    if [ "$DAYTONA_IBUS" = start ]; then
        export XMODIFIERS=@im=ibus DAYTONA_IBUS_EXEC
    else
        unset XMODIFIERS DAYTONA_IBUS_EXEC
    fi
    export DAYTONA_IBUS
fi

# VMware's virtual GPU (vmwgfx) cannot free the handles of imported GPU
# buffers through the standard call: it always fails with EINVAL. wlroots
# 0.18 takes that as a bad buffer and disconnects the client, so every
# GPU-drawn app (GTK 4, and Xwayland, taking the session with it) is thrown
# out as soon as it shows a window. Drawing with the software renderer
# offers no GPU buffers, so apps use shared memory instead. Set WLR_RENDERER
# yourself to override this.
if [ -z "${WLR_RENDERER:-}" ]; then
    for driver in /sys/class/drm/card*/device/driver; do
        if [ "$(basename "$(readlink -f "$driver")")" = vmwgfx ]; then
            export WLR_RENDERER=pixman
            break
        fi
    done
fi

# Programs started by D-Bus or systemd rather than from the session (portal
# dialogs such as the file chooser, D-Bus-activated applications, systemd
# user services) see only the activation environment. labwc adds its
# WAYLAND_DISPLAY, XDG_CURRENT_DESKTOP and cursor variables to it, and the
# labwc autostart file adds the theme variables above, and both take them
# out again at log off (the labwc shutdown file). labwc decides alone,
# updating only when it drives the screens itself; Daytona's additions must
# follow the same decision, so it is made here, the same way, unless already
# set: not when started inside another desktop (nested in its Wayland or X
# session) or on another wlroots backend, whose activation environment
# belongs to that desktop.
if [ -z "${LABWC_UPDATE_ACTIVATION_ENV:-}" ]; then
    LABWC_UPDATE_ACTIVATION_ENV=true
    if [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; then
        LABWC_UPDATE_ACTIVATION_ENV=false
    fi
    case ",${WLR_BACKENDS:-drm}," in
    *,drm,*) ;;
    *) LABWC_UPDATE_ACTIVATION_ENV=false ;;
    esac
    export LABWC_UPDATE_ACTIVATION_ENV
fi

# Daytona's patched labwc (bevelled NT window frames), installed next to this
# script's prefix; the system's labwc if it was built without it.
bindir="$(dirname "$(readlink -f "$0")")"
labwc="$bindir/../libexec/daytona/labwc"
[ -x "$labwc" ] || labwc=labwc

# labwc reads its configuration from a directory of the session's own: the
# installed files, linked, plus an environment file with the keyboard
# layouts (Keyboard Properties, else the system's, /etc/default/keyboard).
# The shell rewrites that file and has labwc reload it when the layouts
# change, so they apply at once.
labwc_config="${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}/daytona-labwc"
(umask 077 && mkdir -p "$labwc_config")
for file in "@DAYTONA_LABWC_DIR@"/*; do
    [ -e "$file" ] && ln -sfn "$file" "$labwc_config/"
done
shell="$bindir/daytona-shell"
[ -x "$shell" ] || shell=daytona-shell
if ! "$shell" --labwc-environment >"$labwc_config/environment" 2>/dev/null; then
    rm -f "$labwc_config/environment"
fi
export DAYTONA_LABWC_CONFIG="$labwc_config"

exec "$labwc" --config-dir "$labwc_config" "$@"
