#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Starts a Daytona session: labwc with Daytona's configuration, which in turn
# starts daytona-shell from its autostart file.

# Desktop name used for OnlyShowIn/NotShowIn and by portals. Display managers
# usually set this from DesktopNames already; set it for direct starts too.
export XDG_CURRENT_DESKTOP=Daytona
export XDG_SESSION_DESKTOP=Daytona

# GTK 3 applications use the Daytona GTK theme (Chicago95 in the current
# colour scheme), and everything uses the Windows 95 cursors. Set here, for
# this session only, so other desktops' settings are left alone.
export GTK_THEME=Daytona
# Qt 6 applications use the Daytona style (Qt 5 ones cannot load it; see
# docs/third-party-apps.md).
export QT_STYLE_OVERRIDE=daytona
export XCURSOR_THEME="Chicago95 Standard Cursors"

# VMware's virtual GPU (vmwgfx) cannot free the handles of imported GPU
# buffers through the standard call: it always fails with EINVAL. wlroots
# 0.18 takes that as a bad buffer and disconnects the client, so every
# GPU-drawn app (GTK 4, and Xwayland, taking the session with it) is thrown
# out as soon as it shows a window. Drawing with the software renderer
# offers no GPU buffers, so apps use shared memory instead. Set WLR_RENDERER
# yourself to override this.
if [ -z "${WLR_RENDERER:-}" ]; then
    for driver in /sys/class/drm/card*/device/driver; do
        if [ "$(basename "$(readlink -f "$driver")")" = vmwgfx ]; then
            export WLR_RENDERER=pixman
            break
        fi
    done
fi

# Daytona's patched labwc (bevelled NT window frames), installed next to this
# script's prefix; the system's labwc if it was built without it.
labwc="$(dirname "$(readlink -f "$0")")/../libexec/daytona/labwc"
[ -x "$labwc" ] || labwc=labwc
exec "$labwc" --config-dir "@DAYTONA_LABWC_DIR@" "$@"
